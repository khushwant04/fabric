# Fabric control-plane configuration template. Copy to .env and fill locally.
# Never commit a populated .env file.

FABRIC_APP_ENV=local
FABRIC_LOG_LEVEL=INFO

# PostgreSQL (async driver). Example:
# postgresql+asyncpg://fabric:fabric@localhost:5432/fabric
FABRIC_DATABASE_URL=postgresql+asyncpg://fabric:fabric@localhost:5432/fabric

# Auth0 tenant that authenticates humans.
FABRIC_AUTH0_ISSUER=https://fabric.jp.auth0.com/
# Identifier of the Auth0 API that represents the Fabric control API.
FABRIC_AUTH0_AUDIENCE=https://api.fabric.example/control
# Optional: restrict accepted signing algorithms (default RS256).
FABRIC_AUTH0_ALGORITHMS=RS256

# Fabric-issued token settings.
FABRIC_JWT_ISSUER=https://control.fabric.example
FABRIC_CONTROL_TOKEN_TTL_SECONDS=900
FABRIC_INFERENCE_TOKEN_TTL_SECONDS=900

# PEM-encoded RSA private key used to sign Fabric JWTs.
# Generate locally: openssl genrsa -out signing.pem 2048
FABRIC_JWT_PRIVATE_KEY_PATH=./signing.pem
# Optional retiring key kept in JWKS during rotation overlap.
FABRIC_JWT_PREVIOUS_PUBLIC_KEY_PATH=

# Server-side pepper for API-key and cluster-credential verifiers.
# Required outside local/test: the service refuses to start while this is unset,
# left as "replace-me", or still the built-in development default.
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
FABRIC_CREDENTIAL_PEPPER=replace-me

# Slug of the protected internal account that owns managed inference stamps.
FABRIC_SYSTEM_ACCOUNT_SLUG=fabric-system
