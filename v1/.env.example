# Public console origin used by Auth0 redirects.
APP_BASE_URL=http://localhost:3000

# Auth0 Regular Web Application credentials. Keep the secret values server-only.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_AUDIENCE=https://api.fabric.example/control

# Server-only control-plane origin. Browser code never calls this URL directly.
FABRIC_CONTROL_PLANE_URL=http://localhost:8080

# Server-only inference gateway base URL, e.g. https://inference.fabric.example.
# The playground always checks the selected account's ready placements first.
# Only HTTPS is accepted, except explicitly configured localhost HTTP in development.
FABRIC_INFERENCE_URL=

# If no fixed gateway URL is configured, allow status-reported gateway endpoints
# only on these exact, comma-separated HTTPS origins. Redirects are never followed.
# Example: https://inference.fabric.example,https://inference-eu.fabric.example
FABRIC_INFERENCE_ALLOWED_ORIGINS=

# Optional destinations used by console help links.
NEXT_PUBLIC_FABRIC_DOCS_URL=
NEXT_PUBLIC_FABRIC_STATUS_URL=
NEXT_PUBLIC_FABRIC_SUPPORT_URL=
