<mxfile host="app.diagrams.net"><diagram id="fabric-arch" name="Fabric architecture"><mxGraphModel dx="1800" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:20px'&gt;Fabric — managed inference platform&lt;/b&gt;&lt;br&gt;Control + edge on AKS · GPU stamps on AKS, GCP and VMs" style="text;html=1;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="420" height="60" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color='#1f6feb'&gt;━━ inference traffic (HTTPS)&lt;/font&gt;&lt;br&gt;&lt;font color='#2e7d32'&gt;╌╌ control traffic — outbound only from stamps&lt;/font&gt;&lt;br&gt;&lt;font color='#b38f00'&gt;╌╌ management API / token exchange&lt;/font&gt;&lt;br&gt;&lt;font color='#57606a'&gt;┄┄ routing table / key sync (cached locally)&lt;/font&gt;&lt;br&gt;Dashed border = in progress on this branch&lt;br&gt;Inference never passes through the control plane" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#5f6b7a;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1380" y="20" width="380" height="150" as="geometry"/></mxCell><mxCell id="clients" value="Clients" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8f9fa;strokeColor=#5f6b7a;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="500" y="20" width="840" height="130" as="geometry"/></mxCell><mxCell id="c_openai" value="&lt;b&gt;OpenAI SDK apps&lt;/b&gt;&lt;br&gt;chat · completions · responses" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#b38f00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="60" width="190" height="70" as="geometry"/></mxCell><mxCell id="c_anth" value="&lt;b&gt;Anthropic SDK apps&lt;/b&gt;&lt;br&gt;/v1/messages" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#b38f00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="725" y="60" width="190" height="70" as="geometry"/></mxCell><mxCell id="c_agents" value="&lt;b&gt;AI agents&lt;/b&gt;&lt;br&gt;run budgets · tool loops" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#b38f00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="60" width="190" height="70" as="geometry"/></mxCell><mxCell id="c_admin" value="&lt;b&gt;Admins&lt;/b&gt;&lt;br&gt;browser" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#b38f00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1135" y="60" width="190" height="70" as="geometry"/></mxCell><mxCell id="idp" value="&lt;b&gt;Identity provider&lt;/b&gt;&lt;br&gt;Auth0 / any OIDC (per account)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#888888;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="200" height="70" as="geometry"/></mxCell><mxCell id="aks" value="Azure AKS — central: control plane + edge gateway" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8f9fa;strokeColor=#5f6b7a;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="1720" height="400" as="geometry"/></mxCell><mxCell id="console" value="&lt;b&gt;Console&lt;/b&gt; (Next.js)&lt;br&gt;deployments · stamps · usage&lt;br&gt;audit · access · playground" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#3b6db3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="260" width="240" height="110" as="geometry"/></mxCell><mxCell id="cp" value="&lt;b&gt;Control plane&lt;/b&gt; (FastAPI)&lt;br&gt;• accounts, members, service principals&lt;br&gt;• API keys · OIDC · token exchange (RS256 JWT, JWKS)&lt;br&gt;• deployments · capacity-aware placement&lt;br&gt;• stamp enrollment, heartbeat, credential rotation&lt;br&gt;• usage ingestion · audit trail + export&lt;br&gt;• edge routing table API &lt;i&gt;(in progress)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#3b6db3;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="250" width="400" height="210" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;row-level security FORCED" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#dae8fc;strokeColor=#3b6db3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="490" width="240" height="90" as="geometry"/></mxCell><mxCell id="edge" value="&lt;b&gt;Edge gateway&lt;/b&gt; — one inference URL &lt;i&gt;(in progress)&lt;/i&gt;&lt;br&gt;• verifies the token locally, refuses before forwarding&lt;br&gt;• routing table from control plane, cached on disk&lt;br&gt;&amp;nbsp;&amp;nbsp;→ keeps serving if the control plane is down&lt;br&gt;• picks a healthy stamp holding the model · failover&lt;br&gt;• run-id / session affinity to one stamp&lt;br&gt;• streams through · no metering (stamps meter)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5f5;strokeColor=#6a3fb5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="830" y="250" width="460" height="210" as="geometry"/></mxCell><mxCell id="obs" value="&lt;b&gt;Observability&lt;/b&gt;&lt;br&gt;Prometheus · Grafana&lt;br&gt;engine, gateway, GPU and agent-run metrics" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1370" y="260" width="360" height="110" as="geometry"/></mxCell><mxCell id="st_a" value="Stamp: aks-gpu — AKS GPU node pools" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f1f8f2;strokeColor=#3d8b4f;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="540" height="520" as="geometry"/></mxCell><mxCell id="gw_a" value='&lt;b&gt;Gateway&lt;/b&gt; (data plane)&lt;br&gt;• JWT verified locally · account ownership · rate / token / concurrency limits&lt;br&gt;• /v1/chat/completions · /v1/completions · /v1/responses · &lt;b&gt;/v1/messages&lt;/b&gt;&lt;br&gt;• model "auto" routing · prefix-aware balancing · retries + health&lt;br&gt;• &lt;b&gt;agent runs&lt;/b&gt;: budgets · trace /v1/runs · tool-call guard&lt;br&gt;• &lt;i&gt;tool loop /v1/agent/runs · model "cascade" (in progress)&lt;/i&gt;&lt;br&gt;• durable usage spool' style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5f5;strokeColor=#6a3fb5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="735" width="500" height="165" as="geometry"/></mxCell><mxCell id="ag_a" value="&lt;b&gt;Agent · Operator · Collector&lt;/b&gt; (Go)&lt;br&gt;• enroll + heartbeat (outbound)&lt;br&gt;• reconcile CRD → vLLM pods&lt;br&gt;• zero-downtime rollouts&lt;br&gt;• forward usage exactly once" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#3d8b4f;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="925" width="240" height="125" as="geometry"/></mxCell><mxCell id="vl_a" value="&lt;b&gt;vLLM model host&lt;/b&gt;&lt;br&gt;Qwen3.5 (small models)&lt;br&gt;Fabric Triton gated-delta kernel&lt;br&gt;kernel_mode auto · fallback to vLLM" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#c76e00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="925" width="240" height="125" as="geometry"/></mxCell><mxCell id="gpu_a" value="&lt;b&gt;GPU nodes&lt;/b&gt;: NVIDIA T4 (SM75, FP16 only) · NVIDIA A10 (SM86)&lt;br&gt;per-GPU kernel launch table · drivers via AKS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#3a3f47;strokeColor=#1f2328;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1075" width="500" height="115" as="geometry"/></mxCell><mxCell id="st_b" value="Stamp: gcp-rtx6000 — GCP VM, single-node k3s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f1f8f2;strokeColor=#3d8b4f;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="610" y="690" width="540" height="520" as="geometry"/></mxCell><mxCell id="gw_b" value="&lt;b&gt;Gateway&lt;/b&gt; (data plane)&lt;br&gt;same image and features as aks-gpu:&lt;br&gt;OpenAI + Responses + Messages APIs, limits,&lt;br&gt;agent runs, tool guard, metering" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5f5;strokeColor=#6a3fb5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="735" width="500" height="165" as="geometry"/></mxCell><mxCell id="ag_b" value="&lt;b&gt;Agent · Operator · Collector&lt;/b&gt; (Go)&lt;br&gt;• enroll + heartbeat (outbound)&lt;br&gt;• reconcile CRD → vLLM pods&lt;br&gt;• zero-downtime rollouts&lt;br&gt;• forward usage exactly once" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#3d8b4f;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="925" width="240" height="125" as="geometry"/></mxCell><mxCell id="vl_b" value="&lt;b&gt;vLLM model host&lt;/b&gt;&lt;br&gt;Qwen3.5 (small models)&lt;br&gt;Fabric Triton gated-delta kernel&lt;br&gt;kernel_mode auto · fallback to vLLM" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#c76e00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="925" width="240" height="125" as="geometry"/></mxCell><mxCell id="gpu_b" value="&lt;b&gt;GPU&lt;/b&gt;: NVIDIA RTX PRO 6000 (Blackwell, 96 GB)&lt;br&gt;default kernel tile (not yet tuned) · site-managed drivers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#3a3f47;strokeColor=#1f2328;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="1075" width="500" height="115" as="geometry"/></mxCell><mxCell id="st_c" value="Stamp: vm-gpu — VM, single-node k3s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f1f8f2;strokeColor=#3d8b4f;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1180" y="690" width="540" height="520" as="geometry"/></mxCell><mxCell id="gw_c" value="&lt;b&gt;Gateway&lt;/b&gt; (data plane)&lt;br&gt;same image and features as aks-gpu:&lt;br&gt;OpenAI + Responses + Messages APIs, limits,&lt;br&gt;agent runs, tool guard, metering" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5f5;strokeColor=#6a3fb5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="735" width="500" height="165" as="geometry"/></mxCell><mxCell id="ag_c" value="&lt;b&gt;Agent · Operator · Collector&lt;/b&gt; (Go)&lt;br&gt;• enroll + heartbeat (outbound)&lt;br&gt;• reconcile CRD → vLLM pods&lt;br&gt;• zero-downtime rollouts&lt;br&gt;• forward usage exactly once" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#3d8b4f;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="925" width="240" height="125" as="geometry"/></mxCell><mxCell id="vl_c" value="&lt;b&gt;vLLM model host&lt;/b&gt;&lt;br&gt;Qwen3.5 (small models)&lt;br&gt;Fabric Triton gated-delta kernel&lt;br&gt;kernel_mode auto · fallback to vLLM" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#c76e00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1460" y="925" width="240" height="125" as="geometry"/></mxCell><mxCell id="gpu_c" value="&lt;b&gt;GPU&lt;/b&gt;: NVIDIA A10 / T4&lt;br&gt;bootstrap-k3s.sh --nvidia · site-managed drivers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#3a3f47;strokeColor=#1f2328;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="1075" width="500" height="115" as="geometry"/></mxCell><mxCell id="e_inf" value="Inference — one URL&lt;br&gt;Bearer or x-api-key token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2.5;strokeColor=#1f6feb;fontColor=#1f6feb;" edge="1" parent="1" source="c_agents" target="edge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_tok" value="API key → short-lived token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#b38f00;fontColor=#8a6d00;dashed=1;" edge="1" parent="1" source="c_openai" target="cp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_admin" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#b38f00;fontColor=#8a6d00;dashed=1;" edge="1" parent="1" source="c_admin" target="console"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_console" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#b38f00;fontColor=#8a6d00;dashed=1;" edge="1" parent="1" source="console" target="cp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_pg" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#3b6db3;" edge="1" parent="1" source="cp" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_idp" value="OIDC sign-in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#b38f00;fontColor=#8a6d00;dashed=1;" edge="1" parent="1" source="cp" target="idp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_route" value="routing table poll" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#6e7781;fontColor=#57606a;dashed=1;dashPattern=2 3;" edge="1" parent="1" source="edge" target="cp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_edge_a" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2.5;strokeColor=#1f6feb;fontColor=#1f6feb;" edge="1" parent="1" source="edge" target="gw_a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_ctrl_a" value="outbound only: enroll · heartbeat&lt;br&gt;desired state · usage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#2e7d32;fontColor=#2e7d32;dashed=1;" edge="1" parent="1" source="ag_a" target="cp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_gwvl_a" value="proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2.5;strokeColor=#1f6feb;fontColor=#1f6feb;" edge="1" parent="1" source="gw_a" target="vl_a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_agvl_a" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#c76e00;fontColor=#c76e00;" edge="1" parent="1" source="ag_a" target="vl_a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_edge_b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2.5;strokeColor=#1f6feb;fontColor=#1f6feb;" edge="1" parent="1" source="edge" target="gw_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_ctrl_b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#2e7d32;fontColor=#2e7d32;dashed=1;" edge="1" parent="1" source="ag_b" target="cp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_gwvl_b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2.5;strokeColor=#1f6feb;fontColor=#1f6feb;" edge="1" parent="1" source="gw_b" target="vl_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_agvl_b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#c76e00;fontColor=#c76e00;" edge="1" parent="1" source="ag_b" target="vl_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_edge_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2.5;strokeColor=#1f6feb;fontColor=#1f6feb;" edge="1" parent="1" source="edge" target="gw_c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_ctrl_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=bl