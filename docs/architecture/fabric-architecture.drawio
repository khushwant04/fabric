<mxfile host="app.diagrams.net"><diagram id="fabric-arch" name="Fabric architecture"><mxGraphModel adaptiveColors="auto" dx="1400" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1420" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Fabric — multi-cloud inference platform" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="520" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Control plane + edge gateway on AKS · GPU stamps on AKS node pools, GCP and VMs" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;fontColor=#5A626E;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="620" height="24" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1F6FEB&quot;&gt;━━ inference (HTTPS)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;╌╌ control, outbound only from stamps&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B38F00&quot;&gt;╌╌ management / token exchange&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#C76E00&quot;&gt;━━ operator creates model hosts&lt;/font&gt;&lt;br&gt;Dashed box = in progress" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="10" width="300" height="120" as="geometry"/></mxCell><mxCell id="users" value="Apps &amp;amp; AI agents&lt;br&gt;&lt;small&gt;OpenAI SDK · Anthropic SDK&lt;/small&gt;" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/assets/users-and-roles/1/Developer-38.svg;fontSize=14;labelPerimeter=1;" vertex="1" parent="1"><mxGeometry x="842" y="40" width="45" height="60" as="geometry"/></mxCell><mxCell id="admins" value="Admins&lt;br&gt;&lt;small&gt;brows