# Fabric data-plane configuration template. Copy to .env and fill locally.
# Never commit a populated .env file.

FABRIC_DP_APP_ENV=local
FABRIC_DP_LOG_LEVEL=INFO

# Issuer claim that Fabric-signed tokens must carry. Must match the control
# plane's FABRIC_JWT_ISSUER exactly, or every token is rejected.
FABRIC_DP_JWT_ISSUER=https://control.fabric.example

# Where the control plane publishes signing keys. Fetched and cached; inference
# does not wait on this once a usable key set is held.
FABRIC_DP_JWKS_URL=https://control.fabric.example/.well-known/jwks.json
FABRIC_DP_JWKS_REFRESH_SECONDS=300

# Optional key set on disk, used to start serving during a control-plane outage
# before any successful fetch. Public keys only.
FABRIC_DP_JWKS_FILE=

# Deployments assigned to this stamp, written by the cluster agent.
FABRIC_DP_DEPLOYMENTS_FILE=deployments.json

# Clock skew allowance when validating token time claims.
FABRIC_DP_LEEWAY_SECONDS=30

# Model host request timeout, which bounds long streaming generations.
FABRIC_DP_UPSTREAM_TIMEOUT_SECONDS=300

# Maximum records retained in the local usage spool. Oldest unleased records are
# dropped rather than growing without limit.
FABRIC_DP_USAGE_BUFFER_SIZE=10000

# Optional SQLite spool file. Leave empty for an in-memory local development spool;
# production sets this to a retained volume (the Helm chart does so by default).
FABRIC_DP_USAGE_SPOOL_PATH=


# Optional stamp-local shared limiter. Leave unset for one-process local development.
# Production Helm configures a private coordinator and retained store automatically.
FABRIC_DP_LIMIT_COORDINATOR_URL=
FABRIC_DP_LIMIT_COORDINATOR_TOKEN=
FABRIC_DP_LIMIT_COORDINATOR_STORE_PATH=
FABRIC_DP_LIMIT_COORDINATOR_TIMEOUT_SECONDS=2
FABRIC_DP_LIMIT_LEASE_SECONDS=900
FABRIC_DP_LIMIT_RENEW_SECONDS=30
