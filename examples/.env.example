# Fabric service roots (omit a trailing /v1; it is tolerated if present)
FABRIC_CONTROL_URL=https://control.example.com
FABRIC_INFERENCE_URL=https://inference.example.com
FABRIC_API_KEY=fab_key_replace_with_your_key

# Optional example inputs
FABRIC_MODEL=qwen3.5-0.8b
FABRIC_MODELS=model-alias-one,model-alias-two
FABRIC_IMAGE_URL=https://example.com/image.jpg
FABRIC_IMAGE_FILE=/absolute/path/to/image.jpg
FABRIC_AUDIO_FILE=/absolute/path/to/audio.wav
